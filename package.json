{
  "name": "fireplay",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/build-vision.mjs",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "node scripts/build-vision.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "assets": "node scripts/setup-assets.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.32",
    "onnxruntime-web": "1.23.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "0.181.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "0.181.0",
    "@vitejs/plugin-react": "5.1.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
